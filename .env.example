# AmmaCare secrets. Never commit this file.

# Server
PORT=3000
# Public URL of your server (tunnel or Replit). Fill in later, no trailing slash.
PUBLIC_BASE_URL=

# Twilio: console.twilio.com home page > "Account Info" box
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox number (already filled in)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Amma's phone, the one that joined the sandbox, e.g. whatsapp:+919876543210
PARENT_WHATSAPP=

# Claude API: platform.claude.com > Settings > API keys > Create key
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Sarvam AI (voice notes): dashboard.sarvam.ai > API keys
SARVAM_API_KEY=

# App settings
PARENT_NAME=Amma
CHILD_NAME=Rinkle
# kn-IN (Kannada), hi-IN (Hindi) or en-IN (English)
PARENT_LANGUAGE=kn-IN

# Message budget (Twilio trial): dry = don't send, live = send for real
SEND_MODE=dry
MAX_OUTBOUND_MESSAGES=80
